  "authors": [
    "CommandGrants"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.commandgrants.CommandGrantsMod"
    ],
    "client": [
      "com.example.commandgrants.client.CommandGrantsClient"
    ]
  },
  "mixins": [
